MONGODB_URI=mongodb://127.0.0.1:27017/cafeflow?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=/api
NODE_ENV=development
# Required only for seeding; choose your own password (minimum 10 characters).
SEED_PASSWORD=
# Optional HTTPS webhook that delivers password reset emails. Receives {email, resetUrl}.
RESET_EMAIL_WEBHOOK=
RESET_EMAIL_TOKEN=
